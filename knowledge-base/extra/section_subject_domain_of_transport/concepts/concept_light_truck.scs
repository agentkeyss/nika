concept_light_truck
<- sc_node_class;
<- class;
=> nrel_main_idtf:
	[малотоннажный грузовик]
   (* <- lang_ru;; *);
=> nrel_note:
	[Грузовой автомобиль небольшой грузоподъёмности, предназначенный для перевозки грузов в городской среде. Движущая сила создаётся двигателем внутреннего сгорания, передаётся на колёса через трансмиссию. Конструкция включает шасси, кабину, кузов и системы управления.]
   (* <- lang_ru;; *);;