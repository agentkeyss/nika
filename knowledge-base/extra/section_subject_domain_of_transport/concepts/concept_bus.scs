concept_bus
<- sc_node_class;
<- class;
=> nrel_main_idtf:
	[автобус]
   (* <- lang_ru;; *);
=> nrel_note:
	[автобус - крупное моторизованное транспортное средство для перевозки пассажиров. Двигатель внутреннего сгорания или электродвигатель передаёт мощность на колёса через трансмиссию. Конструкция включает кузов, шасси, систему управления, сидения для пассажиров и двери для посадки и высадки.]
   (* <- lang_ru;; *);
=> nrel_inclusion:
   concept_city_bus;
	concept_coach;;