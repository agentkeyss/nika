concept_private_car
<- sc_node_class;
<- class;
=> nrel_main_idtf:
	[частный автомобиль]
   (* <- lang_ru;; *);
=> nrel_note:
	[Легковое моторизованное транспортное средство, предназначенное для перевозки пассажиров (до 5 человек) физическим лицом. Двигатель внутреннего сгорания или электродвигатель передаёт мощность на колёса через трансмиссию. Конструкция включает кузов, шасси, систему управления и силовую установку.]
   (* <- lang_ru;; *);;