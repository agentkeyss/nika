concept_heavy_truck
<- sc_node_class;
<- class;
=> nrel_main_idtf:
	[тяжёлый грузовик]
   (* <- lang_ru;; *);
=> nrel_note:
	[тяжёлый грузовик - грузовой автомобиль большой грузоподъёмности для междугородних перевозок. Двигатель внутреннего сгорания передаёт мощность на колёса через трансмиссию. Конструкция включает шасси, кабину, платформу или кузов для перевозки грузов и системы управления.]
   (* <- lang_ru;; *);;