tesla_model_s_2022
<- concept_ev_car;
=> nrel_main_idtf:
	[Tesla Model S 2022]
   (* <- lang_ru;; *);
=> nrel_note:
	[Tesla Model S 2022 — легковой электромобиль с электрической силовой установкой и аккумуляторной батареей ёмкостью до 100 кВт·ч, предназначенный для перевозки до 5 пассажиров. Мощность передаётся на колёса через редукторы. Конструкция включает кузов, шасси, электродвигатели, системы управления и аккумуляторную установку.]
   (* <- lang_ru;; *);;