city_bus_mers_2020
<- concept_city_bus;
=> nrel_main_idtf:
	[Mercedes City Bus 2020]
   (* <- lang_ru;; *);
=> nrel_note:
	[Mercedes City Bus 2020 — городской автобус с дизельным двигателем или гибридным приводом, предназначенный для перевозки пассажиров на внутригородских маршрутах. Конструкция включает низкопольный кузов, шасси, системы управления, посадочные места, двери для посадки и высадки пассажиров.]
   (* <- lang_ru;; *);;