coach_volvo_9900
<- concept_coach;
=> nrel_main_idtf:
	[Volvo 9900]
   (* <- lang_ru;; *);
=> nrel_note:
	[Volvo 9900 — междугородный автобус повышенной комфортности с дизельным двигателем, предназначенный для перевозки пассажиров на дальние расстояния. Конструкция включает кузов с багажными отсеками, шасси, сидения для длительных поездок и систему управления.]
   (* <- lang_ru;; *);;