volvo_fh_2015
<- concept_truck;
=> nrel_main_idtf:
	[VOLVO FH 2015]
   (* <- lang_ru;; *);
=> nrel_note:
	[VOLVO FH 2015 — тяжёлый грузовой автомобиль-тягач с дизельным двигателем мощностью 420–540 л.с., предназначенный для перевозки грузов на большие расстояния. Конструкция включает шасси, кабину водителя, сцепное устройство для прицепов, трансмиссию и систему управления.]
   (* <- lang_ru;; *);;