concept_motorcycle
<- sc_node_class;
<- class;
=> nrel_main_idtf:
	[мотоцикл]
   (* <- lang_ru;; *);
=> nrel_note:
	[Двух- или трёхколёсное моторное транспортное средство для индивидуального передвижения. Движущая сила создаётся двигателем внутреннего сгорания или электродвигателем, мощность передаётся на колёса через трансмиссию. Конструкция включает раму, колёса, силовую установку и систему управления.]
   (* <- lang_ru;; *);;