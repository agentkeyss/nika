concept_ground_transport
<- sc_node_class;
<- class;
=> nrel_main_idtf:
	[наземный транспорт]
   (* <- lang_ru;; *);
=> nrel_note:
	[наземный транспорт - yезависимые транспортные средства, предназначенные для перемещения людей и грузов по поверхности земли за счёт двигателя внутреннего сгорания, электрического привода или гибридной силовой установки. Конструкция включает шасси, кузов, силовую установку, колёсные опоры и систему управления.]
   (* <- lang_ru;; *);
=> nrel_inclusion:
	concept_passenger_vehicle;
	concept_freight_vehicle;
	concept_motorcycle;;