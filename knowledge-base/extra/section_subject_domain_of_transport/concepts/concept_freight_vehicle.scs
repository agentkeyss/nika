concept_freight_vehicle
<- sc_node_class;
<- class;
=> nrel_main_idtf:
	[грузовой транспорт]
   (* <- lang_ru;; *);
=> nrel_note:
	[Транспортные средства, предназначенные для перевозки грузов различной массы и объёма. Движущая сила создаётся двигателем внутреннего сгорания или электродвигателем, передаётся на колёсные опоры через трансмиссию. Конструкция включает шасси, кабину, платформу или кузов для перевозки грузов и системы управления.]
   (* <- lang_ru;; *);
=> nrel_inclusion:
	concept_light_truck;
	concept_heavy_truck;
	concept_trailer;;