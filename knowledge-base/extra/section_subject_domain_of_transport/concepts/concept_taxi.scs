concept_taxi
<- sc_node_class;
<- class;
=> nrel_main_idtf:
	[такси]
   (* <- lang_ru;; *);
=> nrel_note:
	[такси - легковой автомобиль, оборудованный для платной перевозки пассажиров. Движущая сила создаётся двигателем внутреннего сгорания или электродвигателем, мощность передаётся на колёсные опоры через трансмиссию. Конструкция может включать системы приёма заказов и отображения информации для пассажиров.]
   (* <- lang_ru;; *);;