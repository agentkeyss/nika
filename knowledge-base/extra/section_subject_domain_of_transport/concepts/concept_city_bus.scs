concept_city_bus
<- sc_node_class;
<- class;
=> nrel_main_idtf:
	[городской автобус]
   (* <- lang_ru;; *);
=> nrel_note:
	[городской автобус - автобус, предназначенный для внутригородских пассажирских перевозок с частыми остановками. Двигатель внутреннего сгорания или электродвигатель передаёт мощность на колёсные опоры через трансмиссию. Конструкция включает низкопольный кузов, систему управления, посадочные места, двери и платформу для пассажиров.]
   (* <- lang_ru;; *);;