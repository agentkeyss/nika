concept_coach
<- sc_node_class;
<- class;
=> nrel_main_idtf:
	[междугородный автобус]
   (* <- lang_ru;; *);
=> nrel_note:
	[Автобус повышенной комфортности для перевозки пассажиров на дальние расстояния. Двигатель внутреннего сгорания передаёт мощность на колёса через трансмиссию. Конструкция включает кузов с багажными отсеками, шасси, систему управления и сидения для длительных поездок.]
   (* <- lang_ru;; *);;