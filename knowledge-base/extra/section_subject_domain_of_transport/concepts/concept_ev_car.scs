concept_ev_car
<- sc_node_class;
<- class;
=> nrel_main_idtf:
	[электромобиль]
   (* <- lang_ru;; *);
=> nrel_note:
	[электромобиль - легковое транспортное средство с электрическим приводом, использующее аккумуляторы или топливные элементы для питания электродвигателей. Мощность передаётся на колёса через редукторы. Конструкция включает кузов, шасси, электродвигатели, системы управления и аккумуляторную установку.]
   (* <- lang_ru;; *);;