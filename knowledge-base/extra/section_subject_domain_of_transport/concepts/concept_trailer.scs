concept_trailer
<- sc_node_class;
<- class;
=> nrel_main_idtf:
	[прицеп]
   (* <- lang_ru;; *);
=> nrel_note:
	[прицеп - транспортное средство без собственного двигателя, предназначенное для буксировки грузов тягачом. Движение осуществляется за счёт сцепки с тягачом. Конструкция включает раму, колёсные опоры, платформу или кузов и сцепное устройство.]
   (* <- lang_ru;; *);;