concept_sea_transport
<- sc_node_class;
<- class;
=> nrel_main_idtf:
    [морской транспорт] (* <- lang_ru;; *);
=> nrel_note:
    [Морской транспорт — вид водного транспорта, осуществляющий перевозки в морских и океанских акваториях.] (* <- lang_ru;; *);
=> nrel_inclusion:
    concept_seaport;
=> nrel_related_concept:
    concept_water_transport;
    concept_river_transport;;