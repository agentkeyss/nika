<- class;
=> nrel_main_idtf:
    [самолет]
    (* <- lang_ru;; *);
=> nrel_note:
    [самолет - это класс воздушных судов тяжелее воздуха, предназначенных для полётов в атмосфере с помощью силового агрегата, создающего тягу и неподвижного относительно других частей аппарата крыла, создающего подъёмную силу.]
