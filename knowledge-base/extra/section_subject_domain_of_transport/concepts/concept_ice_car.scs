concept_ice_car
<- sc_node_class;
<- class;
=> nrel_main_idtf:
	[автомобиль с ДВС]
   (* <- lang_ru;; *);
=> nrel_note:
	[автомобиль с ДВС - легковое транспортное средство с двигателем внутреннего сгорания, работающим на бензине или дизельном топливе. Мощность двигателя передаётся на колёса через трансмиссию. Конструкция включает кузов, шасси, силовую установку и систему управления.]
   (* <- lang_ru;; *);;