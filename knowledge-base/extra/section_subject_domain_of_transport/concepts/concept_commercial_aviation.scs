concept_commercial_aviation
<- sc_node_class;
<- class;
=> nrel_main_idtf:
    [авиация коммерческих перевозок]
    (* <- lang_ru;; *);
=> nrel_note:
    [авиация коммерческих перевозок - это авиация для осуществления воздушных перевозок пассажиров, багажа, грузов или почты за плату на основе заключенного договора, отличающаяся от других видов авиации тем, что связана с предоставлением платных услуг для потребностей граждан и экономики.]
    (* <- lang_ru;; *);
=> nrel_related_concept:
    concept_special_purpose_aviation;
    concept_private_aviation;;